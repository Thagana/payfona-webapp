# Payfona Web Application - Environment Variables

# API Configuration
# The base URL for the backend API server
# Development: http://localhost:3000/api
# Production: https://api.payfona.com
VITE_API_URL=http://localhost:3000/api

# Paystack Payment Gateway
# Your Paystack public key for processing payments
# Get this from your Paystack dashboard: https://dashboard.paystack.com/#/settings/developer
VITE_PAY_STACK_PUBLIC=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
